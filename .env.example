#############################################
#          Wallet Configuration             #
#############################################

# One deployment now serves every network defined in chains.json. Each entry
# there names the variable holding its mnemonic, so mainnet and beta can use
# separate keys rather than sharing one.
#
# Note that a single process holds all of these at once. Keeping them distinct
# limits what a compromise of one network reaches, but they still share a
# process, so this is not the same isolation as separate deployments.

MNEMONIC_MAINNET_MACT="your twelve-word seed phrase here"
MNEMONIC_BETA_MACT="your twelve-word seed phrase here"
MNEMONIC_BETA_POKT="your twelve-word seed phrase here"

# Optional shared fallback, used by any chain whose own variable is unset.
# Leave it empty to keep the keys separate.
mnemonic=""

#############################################
#              Blockchain Config            #
#############################################

# Networks, tokens, endpoints, amounts and limits are all defined in
# chains.json. Point this at another file to serve a different set, for example
# a testing-only subset.
#chainsFile="./chains.json"

#############################################
#               Server Config               #
#############################################

# HTTP port
#port=8088

# Number of reverse proxies in front of this app (Express "trust proxy").
# Rate limiting keys on req.ip, which is only correct when this matches the
# real deployment. 0 = no proxy, 1 = one proxy (nginx / Cloudflare), etc.
trustProxy=1
