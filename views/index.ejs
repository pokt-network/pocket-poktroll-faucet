<!doctype html>
<html lang="en" data-theme="dark">

<head>
  <meta charset="utf-8">
  <script>
    // Runs before paint so a stored preference does not flash the default theme.
    try {
      var t = localStorage.getItem('faucet-theme');
      if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
    } catch (e) {}
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Faucet - Pocket Network</title>
  <meta name="robots" content="index, follow">
  <meta name="description" content="Uniform Faucet Tool For Poktroll">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="icon"
    href="https://pocket.network/wp-content/uploads/2025/01/favicon.png">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-Zenh87qX5JnK2Jl0vWa8Ck2rdkQ2Bzep5IDxbcnCeuOxjzrPF/et3URy9Bv1WTRi" crossorigin="anonymous">
  <style>
    /* ============================================================
       Tokens and primitives ported from the Pocket Network Explorer
       (pokt-network/pnf-explorer, app/globals.css) so the faucet and
       the explorer read as one product. Theme switches via the
       data-theme attribute on <html>.
       ============================================================ */

    :root, [data-theme=dark] {
      --bg-primary:#171c1f; --bg-card:#1e2529; --bg-card-hover:#242c31; --bg-surface:#2a3338;
      --text-primary:#f6f6f6; --text-secondary:#8e9aa3; --text-tertiary:#5a656d;
      --border:hsla(0,0%,96%,.08); --border-hover:hsla(0,0%,96%,.15);
      --star-opacity:1; --grid-dot:hsla(0,0%,96%,.03);
    }
    [data-theme=light] {
      --bg-primary:#f6f6f6; --bg-card:#fff; --bg-card-hover:#f0f0f0; --bg-surface:#e8eaed;
      --text-primary:#171c1f; --text-secondary:#5a656d; --text-tertiary:#8e9aa3;
      --border:rgba(23,28,31,.1); --border-hover:rgba(23,28,31,.2);
      --star-opacity:0; --grid-dot:rgba(23,28,31,.035);
    }
    :root {
      --blue:#025af2; --blue-soft:#4c9bf5; --gold:#ffc547;
      --mint:#48e5c2; --coral:#ff5a5f; --lavender:#b8b8ff;
      --radius-card:12px; --radius-lg:16px; --maxw:1200px;
      --mono:ui-monospace,Menlo,monospace;
    }

    * { box-sizing:border-box; margin:0; padding:0 }
    html { line-height:1.5; -webkit-font-smoothing:antialiased }
    body {
      font-family:'Rubik',ui-sans-serif,system-ui,sans-serif;
      background-color:var(--bg-primary); color:var(--text-primary);
      font-size:16px; min-height:100vh; position:relative; overflow-x:hidden;
      display:flex; flex-direction:column;
    }
    a { color:inherit }

    [data-theme=dark] body:before {
      content:""; position:fixed; inset:0; z-index:0; pointer-events:none;
      background-image:radial-gradient(circle,var(--grid-dot) 1px,transparent 0);
      background-size:24px 24px;
    }

    /* ---- ambient atmosphere: the explorer's starfield, glow and rings ---- */
    .atmosphere { position:fixed; inset:0; overflow:hidden; pointer-events:none; z-index:0; opacity:var(--star-opacity); transition:opacity .4s ease }
    .stars {
      position:absolute; inset:0;
      background-image:
        radial-gradient(2px 2px at 20px 30px,rgba(255,255,255,.8),transparent),
        radial-gradient(2px 2px at 200px 50px,rgba(2,90,242,.8),transparent),
        radial-gradient(1px 1px at 350px 130px,rgba(255,197,71,.7),transparent),
        radial-gradient(2px 2px at 500px 100px,rgba(72,229,194,.6),transparent),
        radial-gradient(1px 1px at 90px 40px,rgba(255,255,255,.9),transparent),
        radial-gradient(2px 2px at 130px 80px,rgba(255,255,255,.5),transparent),
        radial-gradient(1px 1px at 250px 160px,rgba(255,255,255,.6),transparent);
      background-size:550px 200px; animation:twinkle 8s ease-in-out infinite alternate;
    }
    .glow {
      position:fixed; inset:0; pointer-events:none; z-index:0;
      background:
        radial-gradient(ellipse 80% 50% at 20% 15%,rgba(2,90,242,.12) 0%,transparent 50%),
        radial-gradient(ellipse 60% 40% at 85% 80%,rgba(255,197,71,.07) 0%,transparent 50%);
    }
    .ring { position:fixed; border-radius:50%; pointer-events:none; z-index:0 }
    .ring.r1 { width:900px; height:900px; top:-460px; right:-320px; border:1px solid rgba(2,90,242,.08); animation:orbit 120s linear infinite }
    .ring.r2 { width:620px; height:620px; bottom:-320px; left:-220px; border:1px solid rgba(255,197,71,.06); animation:orbit 95s linear infinite reverse }
    [data-theme=light] .glow { opacity:.5 }
    @keyframes twinkle { 0%{opacity:.5} to{opacity:1} }
    @keyframes orbit { 0%{transform:rotate(0)} to{transform:rotate(1turn)} }
    @keyframes pulse { 0%,to{opacity:1} 50%{opacity:.45} }
    @keyframes spin { to{transform:rotate(1turn)} }
    .pulse { animation:pulse 2s ease-in-out infinite }
    @media (prefers-reduced-motion: reduce) {
      .stars,.ring,.pulse { animation:none!important }
      * { scroll-behavior:auto!important }
    }

    /* ---- shell ---- */
    .shell { position:relative; z-index:2; flex:1; display:flex; flex-direction:column }
    header.bar { max-width:var(--maxw); margin:0 auto; width:100%; padding:22px 24px; display:flex; align-items:center; justify-content:space-between; gap:16px }
    .brand { display:flex; align-items:center; gap:11px; text-decoration:none }
    .brand-logo { height:26px; width:auto; flex:none; display:block }
    .brand-logo-light { display:none }
    [data-theme=light] .brand-logo-dark { display:none }
    [data-theme=light] .brand-logo-light { display:block }
    .brand .sub { font-size:13px; font-weight:500; color:var(--text-secondary); padding-left:12px; margin-left:2px; border-left:1px solid var(--border) }
    .bar-right { display:flex; align-items:center; gap:12px }
    .bar-nav { display:flex; gap:20px }
    .bar-nav a { font-size:13.5px; color:var(--text-secondary); text-decoration:none; transition:color .15s ease }
    .bar-nav a:hover, .bar-nav a.active { color:var(--blue-soft) }
    .iconbtn { width:40px; height:40px; display:grid; place-items:center; border-radius:10px; background:var(--bg-card); color:var(--text-secondary); border:1px solid var(--border); cursor:pointer; transition:all .2s ease; font-size:15px }
    .iconbtn:hover { color:var(--text-primary); border-color:var(--border-hover) }
    .netbadge { display:flex; align-items:center; gap:8px; height:40px; padding:0 13px; border-radius:10px; background:var(--bg-card); border:1px solid var(--border); font-size:13px; font-weight:600; color:var(--text-primary); white-space:nowrap }
    .netbadge .dot { width:8px; height:8px; border-radius:50%; flex:none }
    @media(max-width:640px){ .bar-nav{display:none} }

    main { max-width:760px; margin:0 auto; width:100%; padding:20px 24px 56px; flex:1 }

    /* ---- hero ---- */
    .hero { padding:18px 0 26px; text-align:center }
    .hero h1 { font-size:30px; font-weight:600; letter-spacing:-.02em; margin-bottom:6px }
    .hero h1 .accent { color:var(--blue-soft) }
    .hero p { color:var(--text-secondary); font-size:15px }

    /* ---- card ---- */
    .card { background:var(--bg-card); border:1px solid var(--border); border-radius:var(--radius-card); transition:all .2s ease }
    .faucet-card { padding:24px }
    .faucet-card.is-error { border-color:rgba(255,90,95,.5) }
    .faucet-card.is-success { border-color:rgba(72,229,194,.45) }
    .faucet-card.is-pending { border-color:rgba(255,197,71,.45) }

    /* ---- chips: the explorer's network picker ---- */
    .chips { display:flex; flex-wrap:wrap; gap:8px; justify-content:center; margin-bottom:18px }
    /* Rounded rectangle, not a pill. The explorer's own .chip is fully rounded,
       but the house style is a rounded rectangle, and 10px is the radius its
       interactive controls use, matching the input and send button alongside. */
    .chip { padding:7px 14px; border-radius:10px; font-size:.8rem; font-weight:500; background:var(--bg-surface); color:var(--text-secondary); border:1px solid var(--border); transition:all .15s ease; cursor:pointer; font-family:inherit }
    .chip:hover { border-color:var(--border-hover); color:var(--text-primary) }
    .chip.active { background:var(--blue); color:#fff; border-color:var(--blue) }
    .chip:focus-visible, .btn-primary:focus-visible, .iconbtn:focus-visible, .copybtn:focus-visible,
    .request input:focus-visible, footer .rt a:focus-visible, .bar-nav a:focus-visible, .brand:focus-visible {
      outline:2px solid var(--blue); outline-offset:2px;
    }

    /* ---- request row ---- */
    .request { display:flex; gap:10px; flex-wrap:wrap }
    .request input {
      flex:1; min-width:240px; padding:10px 14px; border-radius:10px; font-size:13px; font-family:var(--mono);
      background:var(--bg-primary); color:var(--text-primary); border:1px solid var(--border); outline:none; transition:border-color .15s ease;
    }
    .request input::placeholder { font-family:'Rubik',sans-serif; color:var(--text-tertiary) }
    .request input:focus { border-color:var(--blue) }
    .btn-primary {
      height:42px; padding:0 20px; border-radius:10px; border:1px solid var(--blue); background:var(--blue); color:#fff;
      font-family:inherit; font-size:13.5px; font-weight:600; cursor:pointer; transition:all .2s ease; white-space:nowrap;
    }
    .btn-primary:hover:not(:disabled) { background:#0148c4; border-color:#0148c4 }
    .btn-primary:disabled { background:var(--bg-surface); border-color:var(--border); color:var(--text-tertiary); cursor:not-allowed }

    /* ---- stat strip: the explorer's uppercase label + dot idiom ---- */
    .facts { display:grid; grid-template-columns:repeat(3,1fr); gap:1px; background:var(--border); border:1px solid var(--border); border-radius:var(--radius-card); overflow:hidden; margin-top:18px }
    .fact { background:var(--bg-card); padding:14px 16px }
    .fact .label { font-size:11px; font-weight:500; text-transform:uppercase; letter-spacing:.05em; color:var(--text-tertiary); display:flex; align-items:center; gap:7px }
    .fact .label .dot { width:7px; height:7px; border-radius:50%; flex:none }
    .fact .val { font-size:17px; font-weight:600; margin-top:6px; letter-spacing:-.02em; font-variant-numeric:tabular-nums }
    .fact .val.mono { font-family:var(--mono); font-size:13px; font-weight:500; word-break:break-all }
    .fact .val .unit { font-size:12.5px; font-weight:500; color:var(--text-secondary); margin-left:4px }
    @media(max-width:560px){ .facts{grid-template-columns:1fr} }

    /* ---- result banner ---- */
    .result { border-radius:10px; padding:12px 14px; font-size:13.5px; margin-bottom:16px; border:1px solid transparent; word-break:break-word }
    .result.err { background:rgba(255,90,95,.1); border-color:rgba(255,90,95,.3); color:var(--coral) }
    .result.ok { background:rgba(72,229,194,.09); border-color:rgba(72,229,194,.3); color:var(--mint) }
    /* Submitted but not yet in a block: informational, not a failure. */
    .result.pending { background:rgba(255,197,71,.1); border-color:rgba(255,197,71,.35); color:var(--gold) }
    .result .mono { font-family:var(--mono); font-size:12.5px; word-break:break-all }
    .result a { color:inherit; text-decoration:underline }
    .copybtn { background:none; border:1px solid currentColor; color:inherit; border-radius:6px; font-size:11px; font-family:inherit; padding:2px 8px; margin-left:8px; cursor:pointer }

    /* ---- FAQ ---- */
    .faq { margin-top:34px }
    .faq h2 { font-size:16px; font-weight:600; letter-spacing:-.01em; margin-bottom:14px; color:var(--text-primary) }
    .accordion-item { background:var(--bg-card); border:1px solid var(--border); border-radius:var(--radius-card)!important; margin-bottom:8px; overflow:hidden }
    .accordion-button {
      background:transparent; color:var(--text-primary); border:none; font-family:inherit;
      font-weight:500; font-size:14px; padding:14px 18px; box-shadow:none!important;
    }
    .accordion-button:not(.collapsed) { background:var(--bg-card-hover); color:var(--text-primary) }
    .accordion-button:focus-visible { outline:2px solid var(--blue); outline-offset:-2px }
    [data-theme=dark] .accordion-button::after { filter:invert(1) opacity(.6) }
    .accordion-body { background:transparent; color:var(--text-secondary); font-size:13.5px; padding:0 18px 16px }
    .accordion-body a { color:var(--blue-soft); text-decoration:none }
    .accordion-body a:hover { text-decoration:underline }

    /* ---- footer ---- */
    footer { position:relative; z-index:2; max-width:var(--maxw); margin:20px auto 0; width:100%; padding:24px; border-top:1px solid var(--border); display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:14px }
    footer .lf { font-size:13px; color:var(--text-tertiary) }
    footer .rt { display:flex; gap:20px; flex-wrap:wrap }
    footer .rt a { font-size:13px; color:var(--text-secondary); text-decoration:none }
    footer .rt a:hover { color:var(--blue-soft) }

    /* ---- processing toast ---- */
    .processing-bar {
      position:fixed; bottom:20px; right:20px; z-index:1000;
      background:var(--bg-card); border:1px solid var(--border); color:var(--text-secondary);
      padding:11px 16px; border-radius:10px; font-size:13px; box-shadow:0 8px 28px rgba(0,0,0,.28);
      display:flex; align-items:center; gap:9px;
    }
    .processing-bar .dot { width:7px; height:7px; border-radius:50%; background:var(--gold); flex:none }

    @media(max-width:560px){
      .hero h1 { font-size:24px }
      header.bar { padding:16px }
      .request input { min-width:0 }
    }
  </style>
</head>

<body>
  <div id="app">
    <!-- ambient layers, matching the explorer -->
    <div class="atmosphere"><div class="stars"></div></div>
    <div class="glow"></div>
    <div class="ring r1"></div>
    <div class="ring r2"></div>

    <div class="shell">
      <header class="bar">
        <a class="brand" href="/" :aria-label="logoAlt">
          <img class="brand-logo brand-logo-dark" src="pocket-logo-white.svg" alt="Pocket Network">
          <img class="brand-logo brand-logo-light" src="pocket-logo-black.svg" alt="Pocket Network">
          <span class="sub">Faucet</span>
        </a>
        <div class="bar-right">
          <nav class="bar-nav">
            <a href="https://pocket.network" target="_blank" rel="noopener">About</a>
            <a href="https://explorer.pocket.network/" target="_blank" rel="noopener">Explorer</a>
            <a href="https://docs.pocket.network/" target="_blank" rel="noopener">Docs</a>
          </nav>
          <span class="netbadge" v-if="selected.label">
            <span class="dot" :style="{ background: selected.isBeta ? 'var(--gold)' : 'var(--mint)' }"></span>
            {{ selected.label }}
          </span>
          <button class="iconbtn" type="button" @click="toggleTheme" :aria-label="`Switch to ${theme === 'dark' ? 'light' : 'dark'} theme`">
            <span aria-hidden="true">{{ theme === 'dark' ? '☀' : '☾' }}</span>
          </button>
        </div>
      </header>

      <main>
        <div class="hero">
          <h1>Pocket <span class="accent">{{ selected.label || 'Network' }}</span> Faucet</h1>
          <p>Get free {{ selected.tokenName }} to initialize your Shannon account.</p>
        </div>

        <div class="card faucet-card" :class="{ 'is-error': showError, 'is-success': showSuccess, 'is-pending': showPending }">
          <div v-if="showAlert" class="result" :class="showError ? 'err' : (showPending ? 'pending' : 'ok')" v-html="alertMessage"></div>

          <div class="chips" v-if="chains.length > 1">
            <button
              v-for="c in chains"
              :key="c.id"
              type="button"
              class="chip"
              :class="{ active: c.id === chain }"
              @click="selectChain(c.id)"
            >{{ c.label }} &middot; {{ c.tokenName }}</button>
          </div>

          <div class="request">
            <input
              id="address"
              type="text"
              spellcheck="false"
              autocomplete="off"
              placeholder="Enter your wallet address"
              v-model="address"
              name="address"
              @keyup.enter="!isProcessing && requestToken(this)"
            />
            <button
              type="button"
              class="btn-primary"
              @click="requestToken(this)"
              :disabled="isProcessing || !address"
            >
              <span v-if="!isProcessing">Send {{ selected.txAmount }} {{ selected.tokenName }}</span>
              <span v-else>Sending…</span>
            </button>
          </div>

          <div class="facts">
            <div class="fact">
              <div class="label"><span class="dot" style="background:var(--blue)"></span>You receive</div>
              <div class="val">{{ selected.txAmount }}<span class="unit">{{ selected.tokenName }}</span></div>
            </div>
            <div class="fact">
              <div class="label"><span class="dot" style="background:var(--lavender)"></span>Chain</div>
              <div class="val mono chainid">{{ selected.chainId }}</div>
            </div>
            <div class="fact">
              <div class="label"><span class="dot" style="background:var(--gold)"></span>Limit</div>
              <div class="val" v-if="selected.oneTimeOnly">Once<span class="unit">per address</span></div>
              <div class="val" v-else>{{ selected.limitAddress }}<span class="unit">per {{ selected.limitHours }}h</span></div>
            </div>
          </div>
        </div>

        <div class="faq">
          <h2>Frequently asked questions</h2>
          <div class="accordion" id="faqAccordion">
            <div v-for="(FAQ, index) in FAQs" class="accordion-item" :key="FAQ.id">
              <h3 class="accordion-header" :id="FAQ.id">
                <button
                  class="accordion-button collapsed"
                  type="button"
                  data-bs-toggle="collapse"
                  :data-bs-target="'#' + FAQ.id2"
                  :aria-expanded="index === 0 ? 'true' : 'false'"
                  :aria-controls="FAQ.id2"
                >
                  {{ FAQ.question }}
                </button>
              </h3>
              <div
                :id="FAQ.id2"
                :class="['accordion-collapse', 'collapse', index === 0 ? 'show' : '']"
                :aria-labelledby="FAQ.id"
                data-bs-parent="#faqAccordion"
              >
                <div class="accordion-body" v-html="FAQ.answer"></div>
              </div>
            </div>
          </div>
        </div>
      </main>
    </div>

    <div id="processing-bar" class="processing-bar" v-if="isProcessing">
      <span class="dot pulse"></span>
      <span>Transaction processing. This can take a few seconds.</span>
    </div>

    <footer role="contentinfo">
      <div class="lf">© <span id="currentYear"></span> Pocket Network</div>
      <nav class="rt" aria-label="Footer">
        <a href="https://forum.pokt.network/" target="_blank" rel="noopener">Forum</a>
        <a href="https://explorer.pocket.network/" target="_blank" rel="noopener">Explorer</a>
        <a href="https://docs.pocket.network/" target="_blank" rel="noopener">Docs</a>
        <a href="https://github.com/pokt-network" target="_blank" rel="noopener">GitHub</a>
        <a href="https://pocket.network/privacy-policy/" target="_blank" rel="noopener">Privacy</a>
        <a href="https://pocket.network/terms-of-use/" target="_blank" rel="noopener">Terms</a>
      </nav>
    </footer>
  </div>

  <script type="module">
    // Set current year for footer
    document.getElementById('currentYear').textContent = new Date().getFullYear();
    
    import { createApp } from 'https://unpkg.com/vue@3/dist/vue.esm-browser.js'

    createApp({
      data() {
        return {
          theme: document.documentElement.getAttribute('data-theme') || 'dark',
          address: '',
          chain: '',
          chains: [],
          conf: {},
          balance: {},
          path: window.location.pathname,
          isProcessing: false,
          showAlert: false,
          alertMessage: '',
          showError: false,
          showSuccess: false,
          showPending: false,
          FAQs: [
            {
              "question": "What is a faucet?",
              "answer": "A faucet serves as a tool for distributing test tokens, which, unlike mainnet tokens, lack intrinsic value and cannot be traded or used on the primary blockchain network. These tokens are solely intended for experimentation, smart contract development, and testing purposes.",
              "id": "flush-headingOne",
              "id2": "flush-collapseOne",
            },
            {
              "question": "How does the faucet work?",
              "answer": `Enter your Pocket Network wallet address in the designated textbox field and click 'Send 10 POKT'. The faucet will generate a transaction and send the testnet tokens to the provided address. If you're interested, you can monitor the transaction's status using a blockchain explorer or an RPC endpoint.`,
              "id": "flush-headingTwo",
              "id2": "flush-collapseTwo",
            },
            {
              "question": "How do I create a new account (wallet)?",
              "answer": `Follow the instructions here: <a href='https://docs.pocket.network/pocketd/accounts-keys/#accounts-and-addresses' target='_blank'>https://docs.pocket.network/pocketd/accounts-keys/#accounts-and-addresses</a>.`,
              "id": "flush-headingThree",
              "id2": "flush-collapseThree",
            },
            {
              "question": "Is there a daily rate limit on token requests?",
              "answer": "Yes, each Pocket Wallet address can request only 2 times per 24 hours.",
              "id": "flush-headingFour",
              "id2": "flush-collapseFour",
            },
            {
              "question": "What if I want more than the allowed token amount?",
              "answer": "To prevent abuse and ensure fair distribution of test tokens, there's a rate limit on the number of request each wallet address can request.",
              "id": "flush-headingFive",
              "id2": "flush-collapseFive",
            },
            {
              "question": "What should I do if my request continues to fail?",
              "answer": "To avoid being mistakenly identified as a bot, please avoid frequent operations and wait a few minutes before trying the next action. If problems persist, don't hesitate to seek assistance on the <a href='https://discord.gg/pokt' target='_blank'>Pocket Network Discord channel.</a>",
              "id": "flush-headingSix",
              "id2": "flush-collapseSix",
            },
            {
              "question": "How do I begin building Web3 Apps on Pocket Network?",
              "answer": "You can get started by visting <a href='https://www.pocket.network' target='_blank'>https://www.pocket.network</a>",
              "id": "flush-headingSeven",
              "id2": "flush-collapseSeven",
            },
            {
              "question": "Have additional questions or feedback?",
              "answer": "We're keen to hear from you. Help us enhance our services by initiating a conversation on our <a href='https://discord.gg/pokt' target='_blank'>Discord server.</a>",
              "id": "flush-headingEight",
              "id2": "flush-collapseEight",
            }
          ],
        }
      },
      created() {
        fetch("config.json").then(response => response.json()).then(data => {
          this.conf = data
          this.chains = data.chains || []
          this.chain = this.chains.length ? this.chains[0].id : data.blockchains[0]
          this.applyChain()
          this.onChange();
        });
      },
      computed: {
        // The chain currently on screen. Everything the page renders reads from
        // here, so switching networks needs no other bookkeeping. The fallback
        // keeps the first render safe while config.json is still in flight.
        selected() {
          return this.chains.find(c => c.id === this.chain) || {
            label: '', chainId: '', chainType: '', tokenName: '', txAmount: '',
            limitAddress: '', limitHours: '', isBeta: false, oneTimeOnly: false,
          }
        },
        // Names the network on screen, so the logo does not describe the page
        // as something it is not. Falls back to the unqualified name while
        // config.json is still loading.
        logoAlt() {
          return this.selected.label ? `Pocket ${this.selected.label} Faucet` : 'Pocket Faucet'
        },
        placeholder() {
          if (this.conf.sample) {
            return `Input an address (e.g.: ${this.conf.sample[this.chain]}) to received tokens`
          } else {
            return 'Input an address to received tokens'
          }
        },
        faucet() {
          return this.conf.sample ? this.conf.sample[this.chain] : ''
        }
      },
      methods: {
        toggleTheme() {
          this.theme = this.theme === 'dark' ? 'light' : 'dark'
          document.documentElement.setAttribute('data-theme', this.theme)
          // Wrapped because storage access throws outright in some privacy modes.
          try { localStorage.setItem('faucet-theme', this.theme) } catch {}
        },
        selectChain(id) {
          if (id === this.chain) return
          this.chain = id
          // Clear any result from the previous network so a success or error
          // banner cannot be read as belonging to the newly selected one.
          this.showAlert = false
          this.showError = false
          this.showSuccess = false
          this.showPending = false
          this.alertMessage = ''
          this.applyChain()
          this.onChange()
        },
        // Rewrites the FAQ answers that quote the selected chain's amounts and
        // limits. They are prose, so they cannot just be template bindings.
        applyChain() {
          const s = this.selected
          this.FAQs[1].answer = `Enter your Pocket Network wallet address in the designated textbox field and click 'Send ${s.txAmount} ${s.tokenName}'. The faucet will generate a transaction and send the tokens to the provided address. If you're interested, you can monitor the transaction's status using a blockchain explorer or an RPC endpoint.`
          this.FAQs[3].answer = s.oneTimeOnly
            ? `Yes, each Pocket Wallet address can request ${s.tokenName} only once.`
            : `Yes, each Pocket Wallet address can request ${s.tokenName} only ${s.limitAddress} times per ${s.limitHours} hours.`
        },
        onChange() {
          // this.balance = {} // reset balance
          // fetch(`/balance/${this.chain}`).then(r => r.json()).then(balance => {
          //   this.balance = balance
          // })
        },
        requestToken(obj) {
          if (this.address) {
            this.isProcessing = true;
            this.showAlert = false;
            this.showError = false;
            this.showSuccess = false;
            this.showPending = false;
            obj.disabled = true;

            fetch(`send/${this.chain}/${this.address}`).then(async response => {
              let data = null;
              try {
                data = await response.json();
              } catch (e) {
                data = null;
              }

              this.isProcessing = false;
              obj.disabled = false;

              console.log('Response data:', data);

              // Prefer HTTP status handling first
              if (!response.ok) {
                const message = (data && (data.message || (data.result && data.result.message))) || `Request failed with status ${response.status}`;
                this.showError = true;
                this.showSuccess = false;
                this.alertMessage = message;
                this.showAlert = true;
                return;
              }

              const result = (data && (data.result || data)) || {};

              // If the backend returned a plain string, treat it as an error message
              if (typeof result === 'string') {
                this.showError = true;
                this.showSuccess = false;
                this.alertMessage = result;
                this.showAlert = true;
                return;
              }
              const code = typeof result.code === 'number' ? result.code : 0;
              const txHash = result.txhash || result.hash || '';

              // Submitted but not yet in a block. Expected whenever a block is
              // slower than the broadcast timeout, so it must not read as a
              // failure: the tokens are very likely on their way, and telling
              // the user it failed invites a retry they do not need.
              if (result.status === 'PENDING' && txHash) {
                this.showError = false;
                this.showSuccess = false;
                this.showPending = true;
                this.alertMessage = 'Submitted. Waiting to appear in a block, which can take a minute.'
                  + ' <span class="mono">' + txHash + '</span>'
                  + '<button class="copybtn" type="button" onclick="copyToClipboard(\'' + txHash + '\')">Copy</button>';
                this.showAlert = true;
                return;
              }

              // If backend signals error via result.code, treat as error
              if (code !== 0) {
                this.showError = true;
                this.showSuccess = false;
                this.alertMessage = result.message || 'Request failed. Please try again later.';
                this.showAlert = true;
                return;
              }

              // Success UI with copy-to-clipboard button when we have a hash
              const copyHtml = txHash
                ? ' <span class="mono">' + txHash + '</span><button class="copybtn" type="button" onclick="copyToClipboard(\'' + txHash + '\')">Copy</button>'
                : '';
              this.showSuccess = true;
              this.showError = false;
              this.alertMessage = `Sent.${copyHtml}`;
              this.showAlert = true;
            }).catch(error => {
              this.isProcessing = false;
              obj.disabled = false;
              this.showError = true;
              this.alertMessage = error.message || 'Something went wrong';
              this.showAlert = true;
            });
          } else {
            obj.disabled = false;
            this.showError = true;
            this.alertMessage = 'Enter a wallet address to continue.';
            this.showAlert = true;
          }
        }
      }
    }).mount('#app')
  </script>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-OERcA2EqjJCMA+/3y+gxIOqMEjwtxJY7qPCqsdltbNJuaOe923+mo//f6V8Qbsw3"
    crossorigin="anonymous"></script>
    <script>
      function copyToClipboard(text) {
                              navigator.clipboard.writeText(text).then(() => {
                                alert('Transaction hash copied to clipboard!');
                              }).catch(err => {
                                console.error('Failed to copy: ', err);
                              });
                            }
        </script>
</body>

</html>
